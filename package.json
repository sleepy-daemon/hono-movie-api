{
  "name": "hono-movie-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsup src/index.ts --out-dir dist",
    "docs:dev": "vite",
    "docs:build": "vite build",
    "docs:preview": "vite preview",
    "preview": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.docs.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@hono/swagger-ui": "^0.6.2",
    "dotenv": "^16.0.0",
    "got-scraping": "^4.0.0",
    "hono": "^4.6.0",
    "tough-cookie": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.7.0",
    "lucide-react": "^0.460.0",
    "postcss": "^8.5.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
