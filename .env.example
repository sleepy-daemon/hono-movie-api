# Port the server listens on (default: 4000)
PORT=4000

# Upstream site base URL (default: https://z3.idlixku.com)
BASE_URL=https://z3.idlixku.com

# Shared secret for the Turnstile token pool. Must match the POOL_SECRET
# constant inside userscript/idlix-token-forwarder.user.js. Leave unset to
# disable the pool (POST /tokens returns 404 and stream endpoints only
# accept tokens via the x-verification-token header).
TOKEN_POOL_SECRET=

# Optional: Upstash Redis REST credentials for a token pool shared across
# every lambda instance. Required for Vercel; without them the pool is
# in-process and dies on cold starts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
